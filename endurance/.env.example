# instalar.sh genera un .env con contraseñas aleatorias. No lo subas al repositorio.
WORKER_URL=https://conversaciones.yohual.com
PULLER_TOKEN=cambia-esto-por-una-cadena-aleatoria-de-64-caracteres
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=cambia-esto
MONGO_APP_USER=recolector
MONGO_APP_PASSWORD=cambia-esto
